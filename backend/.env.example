# NagarMitra Backend Environment Variables Configuration
# Copy this file to .env and configure with your credentials

# Port for the Node.js Express server
PORT=5000

# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nagarmitra?retryWrites=true&w=majority

# JSON Web Token Secret Key (min 32 chars — use a secure random string)
JWT_SECRET=replace_with_a_long_random_secret_string_minimum_32_chars

# Designated Administrator Account (used by npm run seed-admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ReplaceWithStrongPassword123!

# Environment
NODE_ENV=production

# Production CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=https://nagarmitra.pages.dev,http://localhost:5000

# ── Email Notifications (Gmail SMTP — FREE up to ~500/day) ───────────────────
# Step 1: Enable 2FA on Gmail → myaccount.google.com/security
# Step 2: Go to myaccount.google.com/apppasswords
# Step 3: Select app "Mail" → device "Other" → name it "NagarMitra"
# Step 4: Copy the 16-char password (no spaces) and paste below
# If not configured, complaint emails are silently skipped (no crash)
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
